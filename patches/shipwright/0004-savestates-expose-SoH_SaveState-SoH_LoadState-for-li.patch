From: Christoph Knochenhauer
 <69197793+ChristophKnochenhauer@users.noreply.github.com>
Date: Sat, 13 Jun 2026 12:51:34 +0200
Subject: [PATCH 4/4] savestates: expose SoH_SaveState/SoH_LoadState for
 library API

---
 soh/soh/Enhancements/savestates.cpp | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/soh/soh/Enhancements/savestates.cpp b/soh/soh/Enhancements/savestates.cpp
index 16fb98690..5b245d16d 100644
--- a/soh/soh/Enhancements/savestates.cpp
+++ b/soh/soh/Enhancements/savestates.cpp
@@ -817,6 +817,24 @@ extern "C" void ProcessSaveStateRequests(void) {
     OTRGlobals::Instance->gSaveStateMgr->ProcessSaveStateRequests();
 }
 
+extern "C" int SoH_SaveState(unsigned int slot) {
+    auto mgr = OTRGlobals::Instance->gSaveStateMgr;
+    if (!mgr) return (int)SaveStateReturn::FAIL_BAD_REQUEST;
+    auto rtn = mgr->AddRequest({ slot, RequestType::SAVE });
+    if (rtn != SaveStateReturn::SUCCESS) return (int)rtn;
+    mgr->ProcessSaveStateRequests();
+    return 0;
+}
+
+extern "C" int SoH_LoadState(unsigned int slot) {
+    auto mgr = OTRGlobals::Instance->gSaveStateMgr;
+    if (!mgr) return (int)SaveStateReturn::FAIL_BAD_REQUEST;
+    auto rtn = mgr->AddRequest({ slot, RequestType::LOAD });
+    if (rtn != SaveStateReturn::SUCCESS) return (int)rtn;
+    mgr->ProcessSaveStateRequests();
+    return 0;
+}
+
 void SaveStateMgr::SetCurrentSlot(unsigned int slot) {
     Ship::Context::GetInstance()->GetWindow()->GetGui()->GetGameOverlay()->TextDrawNotification(1.0f, true,
                                                                                                 "slot %u set", slot);
