From fd7486ec00fb8a12d156489443c70180a0029a74 Mon Sep 17 00:00:00 2001
From: Christoph Knochenhauer
 <69197793+ChristophKnochenhauer@users.noreply.github.com>
Date: Wed, 20 May 2026 14:35:13 +0200
Subject: [PATCH] graph: add SoH_StepFrame and no-op Graph_ThreadEntry in lib
 mode

When BUILD_AS_LIB=ON, expose SoH_StepFrame() as the external entry
point for advancing the game one frame. Graph_ThreadEntry becomes a
no-op so the internal infinite loop is bypassed; external code
(e.g. an RL environment) drives the frame loop instead.
---
 soh/src/code/graph.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/soh/src/code/graph.c b/soh/src/code/graph.c
index 31dcb211e..972071c1f 100644
--- a/soh/src/code/graph.c
+++ b/soh/src/code/graph.c
@@ -515,12 +515,21 @@ static void RunFrame() {
     exit(0);
 }
 
+#ifndef SOH_AS_LIB
 void Graph_ThreadEntry(void* arg0) {
     while (WindowIsRunning()) {
         RunFrame();
     }
 }
+#else
+void Graph_ThreadEntry(void* arg0) {
+    (void)arg0;
+}
 
+void SoH_StepFrame(void) {
+    RunFrame();
+}
+#endif
 void* Graph_Alloc(GraphicsContext* gfxCtx, size_t size) {
     TwoHeadGfxArena* thga = &gfxCtx->polyOpa;
 
-- 
