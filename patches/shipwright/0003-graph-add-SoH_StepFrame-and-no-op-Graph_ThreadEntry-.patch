Subject: [PATCH 3/4] graph: add SoH_StepFrame and no-op Graph_ThreadEntry in
 lib mode

---
 soh/src/code/graph.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/soh/src/code/graph.c b/soh/src/code/graph.c
index 31dcb211e..972071c1f 100644
--- a/soh/src/code/graph.c
+++ b/soh/src/code/graph.c
@@ -515,12 +515,21 @@ static void RunFrame() {
     exit(0);
 }
 
+#ifndef SOH_AS_LIB
 void Graph_ThreadEntry(void* arg0) {
     while (WindowIsRunning()) {
         RunFrame();
     }
 }
+#else
+void Graph_ThreadEntry(void* arg0) {
+    (void)arg0;
+}
 
+void SoH_StepFrame(void) {
+    RunFrame();
+}
+#endif
 void* Graph_Alloc(GraphicsContext* gfxCtx, size_t size) {
     TwoHeadGfxArena* thga = &gfxCtx->polyOpa;
 
