From 3fdd1953497c61e81333134084a57d5cc1bf5f2c Mon Sep 17 00:00:00 2001
From: Christoph Knochenhauer
 <69197793+ChristophKnochenhauer@users.noreply.github.com>
Date: Mon, 25 May 2026 17:12:31 +0200
Subject: [PATCH] Add input controls

---
 soh/include/soh_lib.h | 13 +++++++++++++
 soh/src/code/main.c   | 18 ++++++++++++++++++
 2 files changed, 31 insertions(+)

diff --git a/soh/include/soh_lib.h b/soh/include/soh_lib.h
index 573370386..0edd49085 100644
--- a/soh/include/soh_lib.h
+++ b/soh/include/soh_lib.h
@@ -1,6 +1,8 @@
 #ifndef SOH_LIB_H
 #define SOH_LIB_H
 
+#include <stdint.h>
+
 #ifdef __cplusplus
 extern "C" {
 #endif
@@ -10,6 +12,17 @@ void SoH_StepFrame(void);
 void SoH_Shutdown(void);
 void SoH_SetHeadless(int enabled);
 
+typedef struct {
+    uint16_t buttons;
+    int8_t stick_x;
+    int8_t stick_y;
+    int8_t right_stick_x;
+    int8_t right_stick_y;
+} SoH_Input;
+
+void SoH_SetInput(int port, const SoH_Input* input);
+void SoH_ClearInput(int port);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/soh/src/code/main.c b/soh/src/code/main.c
index c1a8249dc..f57437228 100644
--- a/soh/src/code/main.c
+++ b/soh/src/code/main.c
@@ -12,6 +12,7 @@
 #include <libultraship/bridge.h>
 #include "soh/CrashHandlerExt.h"
 
+#include "soh_lib.h"
 #include "ship/headless/Headless.h"
 
 s32 gScreenWidth = SCREEN_WIDTH;
@@ -230,6 +231,23 @@ void SoH_SetHeadless(int enabled) {
     Ship_Headless_SetEnabled(enabled);
 }
 
+void SoH_SetInput(int port, const SoH_Input* input) {
+    if (input == NULL) {
+        Ship_Headless_ClearPadOverride(port);
+        return;
+    }
+    Ship_Headless_SetPadOverride(port,
+                                 input->buttons,
+                                 input->stick_x,
+                                 input->stick_y,
+                                 input->right_stick_x,
+                                 input->right_stick_y);
+}
+
+void SoH_ClearInput(int port) {
+    Ship_Headless_ClearPadOverride(port);
+}
+
 void SoH_Init(int argc, char** argv) {
     GameConsole_Init();
     InitOTR(argc, argv);
-- 
2.43.0

