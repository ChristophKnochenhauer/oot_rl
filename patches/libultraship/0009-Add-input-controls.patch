From b4f55b76f9ec1dfee07eaeb071a4eca6fe59cea4 Mon Sep 17 00:00:00 2001
From: Christoph Knochenhauer
 <69197793+ChristophKnochenhauer@users.noreply.github.com>
Date: Mon, 25 May 2026 17:12:04 +0200
Subject: [PATCH] Add input controls

---
 include/ship/headless/Headless.h              | 32 +++++++++--
 .../controller/controldeck/ControlDeck.cpp    | 11 ++++
 src/ship/headless/Headless.cpp                | 57 ++++++++++++++++---
 3 files changed, 87 insertions(+), 13 deletions(-)

diff --git a/include/ship/headless/Headless.h b/include/ship/headless/Headless.h
index e8d448de..940ca1f8 100644
--- a/include/ship/headless/Headless.h
+++ b/include/ship/headless/Headless.h
@@ -1,20 +1,40 @@
 #pragma once
 
-#ifdef __cplusplus
+#include <stdint.h>
 
+#ifdef __cplusplus
 namespace Ship::Headless {
+    void SetEnabled(bool enabled);
+    bool IsEnabled();
 
-void SetEnabled(bool enabled);
-bool IsEnabled();
+    struct PadOverride {
+        uint16_t buttons;
+        int8_t stick_x;
+        int8_t stick_y;
+        int8_t right_stick_x;
+        int8_t right_stick_y;
+    };
 
-} // namespace Ship::Headless
+    void SetPadOverride(int port, const PadOverride& pad);
+    void ClearPadOverride(int port);
+    bool HasPadOverride(int port);
+    PadOverride GetPadOverride(int port);
+}
+#endif  // __cplusplus
 
+#ifdef __cplusplus
 extern "C" {
 #endif
 
 void Ship_Headless_SetEnabled(int enabled);
-int Ship_Headless_IsEnabled(void);
+int  Ship_Headless_IsEnabled(void);
+
+void Ship_Headless_SetPadOverride(int port, uint16_t buttons,
+                                  int8_t stick_x, int8_t stick_y,
+                                  int8_t right_stick_x, int8_t right_stick_y);
+void Ship_Headless_ClearPadOverride(int port);
+int  Ship_Headless_HasPadOverride(int port);
 
 #ifdef __cplusplus
 }
-#endif
+#endif
\ No newline at end of file
diff --git a/src/libultraship/controller/controldeck/ControlDeck.cpp b/src/libultraship/controller/controldeck/ControlDeck.cpp
index c7c96f63..46ca392c 100644
--- a/src/libultraship/controller/controldeck/ControlDeck.cpp
+++ b/src/libultraship/controller/controldeck/ControlDeck.cpp
@@ -7,6 +7,8 @@
 #include <imgui.h>
 #include "ship/controller/controldevice/controller/mapping/mouse/WheelHandler.h"
 
+#include "ship/headless/Headless.h"
+
 namespace LUS {
 ControlDeck::ControlDeck(std::vector<CONTROLLERBUTTONS_T> additionalBitmasks,
                          std::shared_ptr<Ship::ControllerDefaultMappings> controllerDefaultMappings,
@@ -69,6 +71,15 @@ void ControlDeck::WriteToOSContPad(OSContPad* pad) {
         if (controller != nullptr) {
             controller->ReadToPad(&pad[i]);
         }
+
+        if (Ship::Headless::HasPadOverride(static_cast<int>(i))) {
+            auto override_pad = Ship::Headless::GetPadOverride(static_cast<int>(i));
+            pad[i].button = override_pad.buttons;
+            pad[i].stick_x = override_pad.stick_x;
+            pad[i].stick_y = override_pad.stick_y;
+            pad[i].right_stick_x = override_pad.right_stick_x;
+            pad[i].right_stick_y = override_pad.right_stick_y;
+        }
     }
 }
 } // namespace LUS
diff --git a/src/ship/headless/Headless.cpp b/src/ship/headless/Headless.cpp
index 7c894bc4..e2bd5119 100644
--- a/src/ship/headless/Headless.cpp
+++ b/src/ship/headless/Headless.cpp
@@ -1,18 +1,41 @@
 #include "ship/headless/Headless.h"
+#include <array>
 
 namespace Ship::Headless {
 
-static bool sEnabled = false;
+namespace {
+    bool s_enabled = false;
+    
+    constexpr int kMaxPorts = 4;
+    std::array<PadOverride, kMaxPorts> s_padOverrides{};
+    std::array<bool, kMaxPorts> s_hasOverride{};
+}
+
+void SetEnabled(bool enabled) { s_enabled = enabled; }
+bool IsEnabled()               { return s_enabled; }
 
-void SetEnabled(bool enabled) {
-    sEnabled = enabled;
+void SetPadOverride(int port, const PadOverride& pad) {
+    if (port < 0 || port >= kMaxPorts) return;
+    s_padOverrides[port] = pad;
+    s_hasOverride[port] = true;
 }
 
-bool IsEnabled() {
-    return sEnabled;
+void ClearPadOverride(int port) {
+    if (port < 0 || port >= kMaxPorts) return;
+    s_hasOverride[port] = false;
 }
 
-} // namespace Ship::Headless
+bool HasPadOverride(int port) {
+    if (port < 0 || port >= kMaxPorts) return false;
+    return s_hasOverride[port];
+}
+
+PadOverride GetPadOverride(int port) {
+    if (port < 0 || port >= kMaxPorts) return {};
+    return s_padOverrides[port];
+}
+
+}  // namespace Ship::Headless
 
 extern "C" {
 
@@ -24,4 +47,24 @@ int Ship_Headless_IsEnabled(void) {
     return Ship::Headless::IsEnabled() ? 1 : 0;
 }
 
-} // extern "C"
+void Ship_Headless_SetPadOverride(int port, uint16_t buttons,
+                                  int8_t stick_x, int8_t stick_y,
+                                  int8_t right_stick_x, int8_t right_stick_y) {
+    Ship::Headless::PadOverride o;
+    o.buttons = buttons;
+    o.stick_x = stick_x;
+    o.stick_y = stick_y;
+    o.right_stick_x = right_stick_x;
+    o.right_stick_y = right_stick_y;
+    Ship::Headless::SetPadOverride(port, o);
+}
+
+void Ship_Headless_ClearPadOverride(int port) {
+    Ship::Headless::ClearPadOverride(port);
+}
+
+int Ship_Headless_HasPadOverride(int port) {
+    return Ship::Headless::HasPadOverride(port) ? 1 : 0;
+}
+
+}
-- 
2.43.0

