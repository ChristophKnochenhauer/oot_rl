From b6d81796697d93f1292da8577547445784ceedeb Mon Sep 17 00:00:00 2001
From: Christoph Knochenhauer
 <69197793+ChristophKnochenhauer@users.noreply.github.com>
Date: Wed, 20 May 2026 21:44:07 +0200
Subject: [PATCH] cmake: add BUILD_AS_LIB option for embedding

When BUILD_AS_LIB=ON, builds SoH as a static library instead of an
executable. Exposes soh/include as a PUBLIC include directory so
external consumers can use #include <soh_lib.h> directly without
configuring their own include paths.

The OS entry point (main/SDL_main in src/code/main.c) is guarded
with SOH_AS_LIB so consumers can provide their own main(). Game
entry point Main() and all globals remain available.
---
 soh/CMakeLists.txt  | 12 +++++++++++-
 soh/src/code/main.c |  2 ++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/soh/CMakeLists.txt b/soh/CMakeLists.txt
index d78340924..1d1d699b8 100644
--- a/soh/CMakeLists.txt
+++ b/soh/CMakeLists.txt
@@ -223,7 +223,17 @@ set(ALL_FILES
 ################################################################################
 # Target
 ################################################################################
-add_executable(${PROJECT_NAME} ${ALL_FILES})
+option(BUILD_AS_LIB "Build SoH as a static library for embedding (e.g. RL environments)" OFF)
+
+if(BUILD_AS_LIB)
+    add_library(${PROJECT_NAME} STATIC ${ALL_FILES})
+    target_compile_definitions(${PROJECT_NAME} PUBLIC SOH_AS_LIB=1)
+    target_include_directories(${PROJECT_NAME} PUBLIC
+        ${CMAKE_CURRENT_SOURCE_DIR}/include
+    )
+else()
+    add_executable(${PROJECT_NAME} ${ALL_FILES})
+endif()
 
 if (CMAKE_SYSTEM_NAME STREQUAL "Windows")
 use_props(${PROJECT_NAME} "${CMAKE_CONFIGURATION_TYPES}" "${DEFAULT_CXX_PROPS}")
diff --git a/soh/src/code/main.c b/soh/src/code/main.c
index c9d87c66c..05f1d40e5 100644
--- a/soh/src/code/main.c
+++ b/soh/src/code/main.c
@@ -44,6 +44,7 @@ void Main_LogSystemHeap(void) {
     osSyncPrintf(VT_RST);
 }
 
+#ifndef SOH_AS_LIB
 #ifdef _WIN32
 int SDL_main(int argc, char* argv[]) {
     AllocConsole();
@@ -71,6 +72,7 @@ int main(int argc, char* argv[]) {
     Heaps_Free();
     return 0;
 }
+#endif
 
 void Main(void* arg) {
     IrqMgrClient irqClient;
